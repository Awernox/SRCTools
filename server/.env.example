# Secrets. Add real values in Railway Variables, never in Git.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
SPEEDRUN_API_KEY=

# Optional configuration.
CHECK_INTERVAL_SECONDS=30
MONITORED_EVENTS=new,verified,rejected

# Empty means every game moderated by the API-key owner.
# Example: MONITORED_GAME_IDS=game_id_one,game_id_two
MONITORED_GAME_IDS=
